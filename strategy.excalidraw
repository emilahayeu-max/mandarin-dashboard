    {
      "id": "H16-body",
      "type": "text",
      "x": 64,
      "y": 7981,
      "width": 502,
      "height": 224,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 20,
      "frameId": null,
      "groupIds": [],
      "index": "b0g",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Следующий шаг · 1–3 месяца\nИспользовать читаемые буквы, реальные\nфотографии и один спокойный стиль. На\nобъявлении сразу показывать повод, дату, цену\nи контакт.\n\nКак понять результат: Текст легко прочесть на\nтелефоне, условия не приходится угадывать.",
      "roughness": 1,
      "roundness": null,
      "seed": 1650470335,
      "strokeColor": "#183c33",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Следующий шаг · 1–3 месяца\nИспользовать читаемые буквы, реальные\nфотографии и один спокойный стиль. На\nобъявлении сразу показывать повод, дату, цену\nи контакт.\n\nКак понять результат: Текст легко прочесть на\nтелефоне, условия не приходится угадывать.",
      "textAlign": "left",
      "updated": 1794778079859,
      "version": 1,
      "versionNonce": 1574880357,
      "verticalAlign": "top"
    },
