    {
      "id": "H15-body",
      "type": "text",
      "x": 1264,
      "y": 7431,
      "width": 502,
      "height": 251.99999999999997,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 20,
      "frameId": null,
      "groupIds": [],
      "index": "b0d",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Следующий шаг · 1–3 месяца\nПосле удачного вечера предложить небольшую\nвыгоду на следующий семейный повод. Заранее\nобъяснить срок и условия; писать человеку с\nего согласия.\n\nКак понять результат: Считать реальные\nповторные бронирования и стоимость\nпредоставленной выгоды.",
      "roughness": 1,
      "roundness": null,
      "seed": 233455164,
      "strokeColor": "#183c33",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Следующий шаг · 1–3 месяца\nПосле удачного вечера предложить небольшую\nвыгоду на следующий семейный повод. Заранее\nобъяснить срок и условия; писать человеку с\nего согласия.\n\nКак понять результат: Считать реальные\nповторные бронирования и стоимость\nпредоставленной выгоды.",
      "textAlign": "left",
      "updated": 1794778079829,
      "version": 1,
      "versionNonce": 1143934904,
      "verticalAlign": "top"
    },
