    {
      "id": "swot0-title",
      "type": "text",
      "x": 64,
      "y": 1370,
      "width": 802,
      "height": 35,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
