      "verticalAlign": "top"
    },
    {
      "id": "swot2-body",
      "type": "text",
      "x": 64,
      "y": 1891,
      "width": 802,
      "height": 251.99999999999997,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 20,
      "frameId": null,
      "groupIds": [],
      "index": "aZ",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Показать готовое предложение: зал, меню, программа, общая цена и человек\nдля связи.\n\nСнять понятный обзор: как найти вход, как выглядят залы и сервировка.\n\nПредложить семейный праздник и корпоратив с заранее согласованной ценой.\n\nПозже провести небольшой музыкальный вечер вместе с исполнителем, если\nгости заранее оплатят участие.",
      "roughness": 1,
      "roundness": null,
      "seed": 841067813,
      "strokeColor": "#183c33",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Показать готовое предложение: зал, меню, программа, общая цена и человек\nдля связи.\n\nСнять понятный обзор: как найти вход, как выглядят залы и сервировка.\n\nПредложить семейный праздник и корпоратив с заранее согласованной ценой.\n\nПозже провести небольшой музыкальный вечер вместе с исполнителем, если\nгости заранее оплатят участие.",
      "textAlign": "left",
      "updated": 1794778079137,
      "version": 1,
      "versionNonce": 298897331,
      "verticalAlign": "top"
    },
    {
      "id": "swot3",
