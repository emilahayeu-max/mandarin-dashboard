    {
      "id": "H17-body",
      "type": "text",
      "x": 664,
      "y": 8012,
      "width": 502,
      "height": 251.99999999999997,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 20,
      "frameId": null,
      "groupIds": [],
      "index": "b0j",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Следующий шаг · 1–3 месяца\nПоказать залы, меню, цены и примеры\nпраздников. В форме спросить дату, число\nгостей, повод и контакт. Дату подтверждает\nуправляющая.\n\nКак понять результат: Запрос доходит до\nуправляющей, гостю понятно, что делать\nдальше.",
      "roughness": 1,
      "roundness": null,
      "seed": 134183272,
      "strokeColor": "#183c33",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Следующий шаг · 1–3 месяца\nПоказать залы, меню, цены и примеры\nпраздников. В форме спросить дату, число\nгостей, повод и контакт. Дату подтверждает\nуправляющая.\n\nКак понять результат: Запрос доходит до\nуправляющей, гостю понятно, что делать\nдальше.",
      "textAlign": "left",
      "updated": 1794778079888,
      "version": 1,
      "versionNonce": 380678130,
      "verticalAlign": "top"
    },
