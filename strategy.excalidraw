      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Позже решить, нужна ли автоматическая\nпомощь с ответами",
      "roughness": 1,
      "roundness": null,
      "seed": 499028853,
      "strokeColor": "#183c33",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Позже решить, нужна ли автоматическая\nпомощь с ответами",
