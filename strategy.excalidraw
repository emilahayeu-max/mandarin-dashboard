    {
      "id": "swot3-title",
      "type": "text",
      "x": 964,
      "y": 1840,
      "width": 802,
      "height": 35,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 22,
      "frameId": null,
      "groupIds": [],
      "index": "ab",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Что важно учесть",
      "roughness": 1,
      "roundness": null,
      "seed": 380180324,
      "strokeColor": "#183c33",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Что важно учесть",
      "textAlign": "left",
      "updated": 1794778079150,
      "version": 1,
      "versionNonce": 229987116,
      "verticalAlign": "top"
    },
    {
      "id": "swot3-body",
      "type": "text",
      "x": 964,
      "y": 1891,
      "width": 802,
      "height": 280,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 20,
      "frameId": null,
      "groupIds": [],
      "index": "ac",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Другие кафе тоже предлагают еду, музыку и свой алкоголь. Нужно понятно\nобъяснить, чем удобен праздник здесь.\n\nСтарые фотографии и отзывы могут влиять на выбор; они не всегда\nпоказывают нынешнее состояние кафе.\n\nНеожиданные доплаты и неудобная рассадка могут испортить впечатление.\n\nПрежде чем отказываться от Relax, стоит посчитать, сколько заказов он\nприносит и во сколько обходится.",
      "roughness": 1,
      "roundness": null,
      "seed": 51971764,
      "strokeColor": "#183c33",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Другие кафе тоже предлагают еду, музыку и свой алкоголь. Нужно понятно\nобъяснить, чем удобен праздник здесь.\n\nСтарые фотографии и отзывы могут влиять на выбор; они не всегда\nпоказывают нынешнее состояние кафе.\n\nНеожиданные доплаты и неудобная рассадка могут испортить впечатление.\n\nПрежде чем отказываться от Relax, стоит посчитать, сколько заказов он\nприносит и во сколько обходится.",
      "textAlign": "left",
      "updated": 1794778079164,
      "version": 1,
      "versionNonce": 414517648,
      "verticalAlign": "top"
    },
