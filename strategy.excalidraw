      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Что стоит попробовать",
      "roughness": 1,
      "roundness": null,
      "seed": 380270921,
      "strokeColor": "#183c33",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Что стоит попробовать",
