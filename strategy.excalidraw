    {
      "id": "H01-body",
      "type": "text",
      "x": 64,
      "y": 5231,
      "width": 502,
      "height": 196,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 20,
      "frameId": null,
      "groupIds": [],
      "index": "ax",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Сделать сначала · 0–14 дней\nЗаписать, какие есть залы, сколько гостей\nудобно сядут, что входит в меню и цену, можно\nли свои напитки и как отменить заказ.\n\nКак понять результат: На обычные вопросы\nгостя есть понятный и одинаковый ответ.",
      "roughness": 1,
      "roundness": null,
      "seed": 1731557297,
      "strokeColor": "#183c33",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Сделать сначала · 0–14 дней\nЗаписать, какие есть залы, сколько гостей\nудобно сядут, что входит в меню и цену, можно\nли свои напитки и как отменить заказ.\n\nКак понять результат: На обычные вопросы\nгостя есть понятный и одинаковый ответ.",
      "textAlign": "left",
