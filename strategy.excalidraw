    },
    {
      "id": "P02-pilot-body",
      "type": "text",
      "x": 664,
      "y": 3231,
      "width": 502,
      "height": 364,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 20,
      "frameId": null,
      "groupIds": [],
      "index": "ar",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Одна компания празднует вместе с коллегами.\n\nУжин, короткая игра с известными песнями и\nкараоке по желанию.\n\nНужны ведущий, исправный звук и согласованное\nвремя подачи еды.\n\nЗаранее договориться с организатором о\nпрограмме, всей цене и оплате.\n\nПроверить расходы и спросить организатора,\nвсё ли прошло хорошо.",
      "roughness": 1,
      "roundness": null,
      "seed": 1087969513,
      "strokeColor": "#183c33",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Одна компания празднует вместе с коллегами.\n\nУжин, короткая игра с известными песнями и\nкараоке по желанию.\n\nНужны ведущий, исправный звук и согласованное\nвремя подачи еды.\n\nЗаранее договориться с организатором о\nпрограмме, всей цене и оплате.\n\nПроверить расходы и спросить организатора,\nвсё ли прошло хорошо.",
      "textAlign": "left",
      "updated": 1794778079308,
      "version": 1,
      "versionNonce": 1949050055,
      "verticalAlign": "top"
    },
    {
